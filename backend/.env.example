# Nouvelage API — environment configuration
# Copy to .env and fill in real values. The server refuses to start in
# production without ADMIN_JWT_SECRET and a database password.

NODE_ENV=development
PORT=4000

# MySQL 8.4
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=nouvelage
DB_PASSWORD=
DB_NAME=nouvelage

# Auth — generate with: openssl rand -hex 48
ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRES=12h

# Salt for hashing submitter IPs (contact/booking forms). Raw IPs are never stored.
IP_HASH_SALT=

# Comma-separated CORS allowlist (dev Angular server + production hosts)
CORS_ORIGINS=http://localhost:4200,https://www.nouvelage.clinic,https://nouvelage.clinic

# Where uploaded media lives on disk (served at /assets/img/... by nginx and by
# this server as a fallback). Relative paths resolve against backend/.
UPLOADS_DIR=../frontend/public/assets/img

# Used only by scripts/create-admin.js — never passed on argv
# ADMIN_EMAIL=admin@nouvelage.clinic
# ADMIN_PASSWORD=
# ADMIN_NAME=Nouvelage Admin
