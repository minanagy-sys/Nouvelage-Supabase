# Nouvelage — nginx server block (new stack, separate root + port).
# The live Supabase deployment stays untouched; this serves the converted
# site from its own root and proxies /api to the Node API on :4000.

server {
    listen 80;
    server_name www.nouvelage.clinic nouvelage.clinic;

    root /var/www/nouvelage-mysql/dist/nouvelage-angular/browser;
    index index.html;

    # Angular SPA — deep links fall back to index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Static assets: long cache, immutable hashed bundles
    location ~* \.(js|css|woff2?)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Uploaded media (WebP canonical + responsive variants)
    location /assets/img/ {
        expires 7d;
        add_header Cache-Control "public";
        try_files $uri =404;
    }

    # API
    location /api/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 20m;
    }

    # Health check without the /api prefix
    location = /health {
        proxy_pass http://127.0.0.1:4000/health;
    }
}
