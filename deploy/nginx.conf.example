# Nouvelage — nginx server block (SSR stack, separate root + ports).
# The live Supabase deployment stays untouched; this proxies pages to the
# Angular SSR server (:4200) and the API to Node (:4000), while serving
# static assets directly from disk.

server {
    listen 80;
    server_name www.nouvelage.clinic nouvelage.clinic;

    # Static browser assets served straight from disk — never hit Node.
    root /var/www/nouvelage-mysql/frontend/dist/nouvelage-angular/browser;

    # Hashed bundles: immutable long cache
    location ~* \.(js|css|woff2?)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri @ssr;
    }

    # Uploaded media (WebP canonical + responsive variants)
    location /assets/ {
        expires 7d;
        add_header Cache-Control "public";
        try_files $uri @ssr;
    }

    # Other static files that live in the browser build (favicon, og images…)
    location ~* \.(ico|png|jpe?g|webp|avif|svg|gif|txt|xml|json|pdf|html)$ {
        expires 1d;
        try_files $uri @ssr;
    }

    # API
    location /api/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 20m;
    }

    # Health check without the /api prefix
    location = /health {
        proxy_pass http://127.0.0.1:4000/health;
    }

    # Everything else: server-side rendered pages from the Angular SSR server.
    # Micro-cache anonymous page renders for 10s — absorbs traffic spikes
    # while dashboard edits still appear within seconds.
    location / {
        try_files /nonexistent @ssr;
    }

    location @ssr {
        proxy_pass http://127.0.0.1:4200;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache ssr_cache;
        proxy_cache_valid 200 10s;
        proxy_cache_bypass $http_authorization $cookie_nouvelage_admin;
        proxy_no_cache $http_authorization $cookie_nouvelage_admin;
        add_header X-SSR-Cache $upstream_cache_status;
    }
}

# Place at http{} level (e.g. /etc/nginx/conf.d/ssr-cache.conf):
#   proxy_cache_path /var/cache/nginx/ssr levels=1:2 keys_zone=ssr_cache:10m
#                    max_size=100m inactive=60s use_temp_path=off;
