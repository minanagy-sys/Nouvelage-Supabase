FROM node:22-alpine AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npx ng build --configuration production

FROM node:22-alpine

WORKDIR /app
COPY --from=build /app/dist/nouvelage-angular ./dist/nouvelage-angular

ENV NODE_ENV=production
EXPOSE 4200

CMD ["node", "dist/nouvelage-angular/server/server.mjs"]
